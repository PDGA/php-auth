{
    "name": "pdga/auth",
    "type": "library",
    "description": "A PDGA library containing auth related code.",
    "keywords": [],
    "homepage": "https://github.com/PDGA/php-auth",
    "license": "MIT",
    "authors": [
        {
            "name": "PDGA",
            "email": "it@pdga.com",
            "homepage": "https://www.pdga.com",
            "role": "Developer"
        }
    ],
    "repositories":[
        {
            "type": "vcs",
            "url": "https://github.com/PDGA/coding-standards.git"
        }
    ],
    "require": {
        "php": ">=7.4.0",
        "pdga/exception": "^1.0",
        "firebase/php-jwt": "^6.0"
    },
    "autoload": {
        "psr-4": {
            "PDGA\\Auth\\": "src/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "pdga/coding-standards": "^1.0"
    },
    "scripts": {
        "sniff": "bin/codesniffer phpcs",
        "format": "bin/codesniffer phpcbf",
        "format-verbose": "bin/codesniffer phpcbf -v"
    }
}
